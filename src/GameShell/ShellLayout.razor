@implements IAsyncDisposable
@inject IJSRuntime JS

@* The page frame shared by the games: menu bar (desktop) or ☰ drawer (mobile), then the board next to the side panels. *@
<div class="app" inert="@Inert">
    <nav class="menubar" aria-label="Menu">
        <div class="menubar-inner">
            <!-- Mobile Header (Visible on screens <= 768px) -->
            <div class="mobile-nav-bar">
                <span class="app-brand">@Brand</span>
                <button class="hamburger-btn"
                        aria-label="Open navigation menu"
                        aria-expanded="@(_mobileDrawerOpen ? "true" : "false")"
                        @onclick="ToggleMobileDrawer">
                    <span class="hamburger-icon">☰</span>
                </button>
            </div>

            <!-- Desktop Menu Bar (Visible on screens > 768px) -->
            <div class="desktop-menu-bar">
                @foreach (MenuDefinition menu in Menus)
                {
                    <div class="menu">
                        <button class="menu-title @(menu == _openMenu ? "open" : null)"
                                aria-haspopup="menu"
                                aria-expanded="@(menu == _openMenu ? "true" : "false")"
                                @onclick="() => ToggleMenu(menu)"
                                @onmouseenter="() => HoverMenu(menu)">
                            @menu.Title
                        </button>
                        @if (menu == _openMenu)
                        {
                            <div class="menu-items" role="menu">
                                @foreach (MenuEntry entry in menu.Entries)
                                {
                                    bool? isChecked = entry.IsChecked?.Invoke();
                                    string role = isChecked is null ? "menuitem" : entry.Radio ? "menuitemradio" : "menuitemcheckbox";
                                    <button role="@role"
                                            aria-checked="@(isChecked is { } c ? (c ? "true" : "false") : null)"
                                            class="@(entry.SeparatorBefore ? "separator-before" : null)"
                                            disabled="@(!entry.Command.CanExecute(null))"
                                            @onclick="() => RunEntryAsync(entry)">
                                        <span class="check">@(isChecked == true ? (entry.Radio ? "●" : "✓") : "")</span>
                                        <span>@entry.Text</span>
                                        <span class="shortcut">@entry.Shortcut</span>
                                    </button>
                                }
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </nav>
    @if (_openMenu is not null)
    {
        <div class="menu-backdrop" @onclick="() => _openMenu = null"></div>
    }

    <!-- Mobile Navigation Drawer -->
    <div class="mobile-drawer @(_mobileDrawerOpen ? "open" : null)" role="dialog" aria-modal="true" aria-label="Game Menu">
        <div class="mobile-drawer-header">
            <span class="mobile-drawer-title">Menu</span>
            <button class="mobile-drawer-close" aria-label="Close menu" @onclick="CloseMobileDrawer">✕</button>
        </div>
        <div class="mobile-drawer-body">
            @foreach (MenuDefinition menu in Menus)
            {
                <div class="mobile-menu-section">
                    <div class="mobile-section-header">@menu.Title</div>
                    <div class="mobile-section-items">
                        @foreach (MenuEntry entry in menu.Entries)
                        {
                            bool? isChecked = entry.IsChecked?.Invoke();
                            <button class="mobile-menu-item @(entry.SeparatorBefore ? "separator-before" : null)"
                                    disabled="@(!entry.Command.CanExecute(null))"
                                    @onclick="() => RunEntryAsync(entry)">
                                <span class="check">@(isChecked == true ? (entry.Radio ? "●" : "✓") : "")</span>
                                <span class="label">@entry.Text</span>
                            </button>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
    @if (_mobileDrawerOpen)
    {
        <div class="mobile-drawer-backdrop" @onclick="CloseMobileDrawer"></div>
    }

    <main class="content">
        <div class="board-area">
            @BoardArea
        </div>
        <div class="side-panels">
            @SidePanels
        </div>
    </main>
</div>

@code {
    private static readonly IReadOnlyDictionary<string, Func<Task>> NoShortcuts = new Dictionary<string, Func<Task>>();

    private MenuDefinition? _openMenu;
    private bool _mobileDrawerOpen;
    private IReadOnlyList<MenuDefinition>? _subscribedMenus;
    private DotNetObjectReference<ShellLayout>? _self;
    private bool _renderPending;

    /// <summary>The game's name, shown in the mobile header.</summary>
    [Parameter, EditorRequired]
    public string Brand { get; set; } = "";

    [Parameter, EditorRequired]
    public IReadOnlyList<MenuDefinition> Menus { get; set; } = [];

    [Parameter]
    public RenderFragment? BoardArea { get; set; }

    [Parameter]
    public RenderFragment? SidePanels { get; set; }

    /// <summary>
    /// Keyboard shortcuts: a lower-case letter for Ctrl+letter, or "f1", "shift+f1" or "f2".
    /// Escape always closes an open menu or the mobile drawer.
    /// </summary>
    [Parameter]
    public IReadOnlyDictionary<string, Func<Task>> Shortcuts { get; set; } = NoShortcuts;

    /// <summary>
    /// Raised after a menu item or shortcut has run. Pass any handler (even an empty one) when commands change
    /// state the page owns itself, such as the board style, so the page re-renders.
    /// </summary>
    [Parameter]
    public EventCallback OnCommand { get; set; }

    /// <summary>True while a modal dialog is open: the page is inert and shortcuts are ignored.</summary>
    [Parameter]
    public bool Inert { get; set; }

    protected override void OnParametersSet()
    {
        // Menu items enable and disable themselves as their commands change.
        if (!ReferenceEquals(Menus, _subscribedMenus))
        {
            Subscribe(_subscribedMenus, subscribe: false);
            Subscribe(Menus, subscribe: true);
            _subscribedMenus = Menus;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _self = DotNetObjectReference.Create(this);
            string letters = string.Concat(Shortcuts.Keys.Where(key => key.Length == 1));
            await JS.InvokeVoidAsync("gameShell.registerShortcuts", _self, letters);
            await JS.InvokeVoidAsync("gameShell.initMenuAlignment");
        }
    }

    public async ValueTask DisposeAsync()
    {
        Subscribe(_subscribedMenus, subscribe: false);
        if (_self is not null)
        {
            try
            {
                await JS.InvokeVoidAsync("gameShell.unregisterShortcuts");
                await JS.InvokeVoidAsync("gameShell.cleanupMenuAlignment");
            }
            catch (JSDisconnectedException)
            {
                // The page is going away.
            }

            _self.Dispose();
        }
    }

    [JSInvokable]
    public async Task OnShortcut(string key)
    {
        if (Inert)
        {
            return;
        }

        if (key == "escape")
        {
            CloseMenus();
        }
        else if (Shortcuts.TryGetValue(key, out Func<Task>? action))
        {
            CloseMenus();
            await action();
            await OnCommand.InvokeAsync();
        }

        StateHasChanged();
    }

    private void Subscribe(IReadOnlyList<MenuDefinition>? menus, bool subscribe)
    {
        foreach (ICommand command in menus?.SelectMany(menu => menu.Entries).Select(entry => entry.Command) ?? [])
        {
            if (subscribe)
            {
                command.CanExecuteChanged += OnCommandChanged;
            }
            else
            {
                command.CanExecuteChanged -= OnCommandChanged;
            }
        }
    }

    private void OnCommandChanged(object? sender, EventArgs e)
    {
        if (_renderPending)
        {
            return;
        }

        _renderPending = true;
        _ = InvokeAsync(async () =>
        {
            await Task.Yield();
            _renderPending = false;
            StateHasChanged();
        });
    }

    private async Task RunEntryAsync(MenuEntry entry)
    {
        CloseMenus();
        await ShellCommands.RunAsync(entry.Command);
        await OnCommand.InvokeAsync();
    }

    private void CloseMenus()
    {
        _openMenu = null;
        _mobileDrawerOpen = false;
    }

    private void ToggleMenu(MenuDefinition menu) => _openMenu = _openMenu == menu ? null : menu;

    private void ToggleMobileDrawer() => _mobileDrawerOpen = !_mobileDrawerOpen;

    private void CloseMobileDrawer() => _mobileDrawerOpen = false;

    private void HoverMenu(MenuDefinition menu)
    {
        if (_openMenu is not null)
        {
            _openMenu = menu;
        }
    }
}
