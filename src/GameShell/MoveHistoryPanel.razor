@inject IJSRuntime JS

<section class="panel history-panel" aria-label="Move History">
    <h2>MOVE HISTORY (@(MoveCount == 1 ? "1 move" : $"{MoveCount} moves"))</h2>
    <div class="history-list" @ref="_list">
        @if (Rows.Count == 0)
        {
            <p class="history-empty">No moves played yet.</p>
        }
        else
        {
            <ol>
                @for (int i = 0; i < Rows.Count; i++)
                {
                    MoveHistoryRow row = Rows[i];
                    bool lastRow = i == Rows.Count - 1;
                    <li>
                        <span class="move-num">@(row.Number).</span>
                        <span class="move-ply @(lastRow && row.Second is null ? "latest" : null)">@row.First</span>
                        @if (row.Second is not null)
                        {
                            <span class="move-ply @(lastRow ? "latest" : null)">@row.Second</span>
                        }
                    </li>
                }
            </ol>
        }
    </div>
</section>

@code {
    private ElementReference _list;
    private int _scrolledMoveCount;

    /// <summary>The rounds played; see <see cref="MoveHistoryRow.Pair"/> for a list of single moves.</summary>
    [Parameter, EditorRequired]
    public IReadOnlyList<MoveHistoryRow> Rows { get; set; } = [];

    /// <summary>Individual moves (both players), as counted in the header.</summary>
    public int MoveCount => Rows.Sum(row => row.Second is null ? 1 : 2);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Keep the newest move in view.
        if (MoveCount != _scrolledMoveCount)
        {
            _scrolledMoveCount = MoveCount;
            await JS.InvokeVoidAsync("gameShell.scrollHistoryToEnd", _list);
        }
    }
}
